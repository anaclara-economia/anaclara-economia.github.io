---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contato"
  description="E-mails profissional e institucional para contato com Ana Clara Cabral."
>
  <section class="hero">
    <h1>Contato</h1>
    <p>Para propostas de trabalho, projetos de análise de dados, colaboração em pesquisa ou perguntas sobre os textos do blog, entre em contato por e-mail.</p>
  </section>

  <section class="panel">
    <h2>E-mails</h2>
    <ul class="resource-list">
      <li>
        <span>Trabalho e contato geral:</span>
        <a href="mailto:econdata.consultoria@gmail.com">econdata.consultoria@gmail.com</a>
      </li>
      <li>
        <span>Contato acadêmico:</span>
        <a href="mailto:ana.cabral@icsa.ufpa.br">ana.cabral@icsa.ufpa.br</a>
      </li>
    </ul>
  </section>
</BaseLayout>
