---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contato"
  description="Perfis acadêmicos e profissionais públicos de Ana Clara Cabral."
>
  <section class="hero">
    <h1>Contato</h1>
    <p>Canal para colaborações acadêmicas, diálogo metodológico e troca institucional.</p>
  </section>

  <section class="panel">
    <h2>Canais</h2>
    <ul class="resource-list">
      <li>
        <a href="https://lattes.cnpq.br/9701201405869987">Currículo Lattes</a>
        <span>produção acadêmica formal.</span>
      </li>
      <li>
        <a href="https://orcid.org/0000-0002-7592-4385">ORCID</a>
        <span>identificador acadêmico internacional.</span>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/ana-clara-santos-cabral/">LinkedIn</a>
        <span>perfil profissional.</span>
      </li>
      <li>
        <a href="https://github.com/anaclara-economia">GitHub</a>
        <span>projetos e códigos.</span>
      </li>
      <li>
        <a href="https://www.olaped.com.br/">LAPED</a>
        <span>Laboratório de Pesquisa em Política Econômica e Desenvolvimento Produtivo.</span>
      </li>
    </ul>
  </section>
</BaseLayout>
