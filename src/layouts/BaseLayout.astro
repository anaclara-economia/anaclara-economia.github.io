---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  sidebarItems?: Array<{
    href: string;
    label: string;
  }>;
}

const { title, description = "Site pessoal acadêmico em Economia Aplicada.", sidebarItems = [] } =
  Astro.props;
const pageTitle =
  title === "Início"
    ? "Ana Clara Cabral - Economia Aplicada"
    : `${title} - Ana Clara Cabral`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const shareImageURL = new URL("/capa-compartilhamento.png", Astro.site ?? Astro.url.origin);
const shareImageAlt = "Ana Clara Cabral — Economia Aplicada, Ciência de dados e Política econômica.";
const currentYear = new Date().getFullYear();
const hasSidebar = sidebarItems.length > 0 || Astro.slots.has("sidebar");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#143f3a" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/profile-mark.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={shareImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageURL} />
    <meta name="twitter:image:alt" content={shareImageAlt} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <SiteHeader />
    <div class="page-shell">
      <div class:list={["page-grid", !hasSidebar && "page-grid--single"]}>
        <main id="conteudo" class="content-column">
          <slot />
        </main>
        {hasSidebar && <slot name="sidebar"><Sidebar items={sidebarItems} /></slot>}
      </div>
    </div>
    <footer class="site-footer">
      <div class="page-shell">
        <p>© {currentYear} Ana Clara Cabral | Economia Aplicada</p>
      </div>
    </footer>
  </body>
</html>
